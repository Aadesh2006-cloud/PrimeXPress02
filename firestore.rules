rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Customer Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}

